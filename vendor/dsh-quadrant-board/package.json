{
  "name": "dsh-quadrant-board",
  "version": "1.0.0",
  "description": "DeepSeek Harness plugin: a task & knowledge board (four-quadrant tasks with drag-and-drop, weekly Markdown notes, quick-launch shortcuts) as a conversation-view tab. Pure-JS backend on the host webServer, zero third-party dependencies.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "taskboard",
    "kanban",
    "notes",
    "shortcuts"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "static",
    "cordis.patch.yml",
    "README.md",
    "package.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
