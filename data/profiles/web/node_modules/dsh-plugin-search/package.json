{
  "name": "dsh-plugin-search",
  "version": "0.1.0",
  "description": "Zero-config web_search for DeepSeek Harness when you are not on the official DeepSeek API.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && node --test dist-test/*.test.js",
    "prepare": "tsc -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shinjiyu/dsh-plugin-search.git"
  },
  "homepage": "https://github.com/shinjiyu/dsh-plugin-search",
  "bugs": {
    "url": "https://github.com/shinjiyu/dsh-plugin-search/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "web-search"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.2.0",
    "typescript": "^5.9.2"
  }
}
