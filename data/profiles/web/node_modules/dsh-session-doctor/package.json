{
  "name": "dsh-session-doctor",
  "version": "1.0.0",
  "packageManager": "pnpm@11.1.1",
  "description": "会话医生:诊断、解卡、读取 DeepSeek Harness 会话。诊断卡死的 agent、中止卡住的活动、保留排队消息并恢复处理。",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "session",
    "agent",
    "diagnosis",
    "recover",
    "stuck"
  ],
  "homepage": "https://github.com/mayf3/dsh-session-doctor#readme",
  "bugs": {
    "url": "https://github.com/mayf3/dsh-session-doctor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mayf3/dsh-session-doctor.git"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshx": {
    "contributes": {
      "tools": [
        "list_sessions",
        "read_session",
        "session_status",
        "session_recover",
        "send_session_message"
      ],
      "skills": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.5 <0.2.0"
  },
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.1.0-rc.5 <0.2.0"
  },
  "license": "MIT"
}
