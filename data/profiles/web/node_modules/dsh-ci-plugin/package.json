{
  "name": "dsh-ci-plugin",
  "version": "0.1.0",
  "description": "Provider-neutral CI/CD capability for DeepSeek Harness with GitHub Actions support",
  "keywords": ["deepseek", "dsh", "plugin", "ci", "cicd", "github-actions", "cordis"],
  "homepage": "https://github.com/xxiaoxiong/dsh-ci",
  "bugs": "https://github.com/xxiaoxiong/dsh-ci/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xxiaoxiong/dsh-ci.git"
  },
  "license": "MIT",
  "author": "xxiaoxiong",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs --testPathPattern='tests/(core|github|failure|tools)/'",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs --testPathPattern='tests/integration/'",
    "pack": "npm pack",
    "prepublishOnly": "npm run build && npm test",
    "lint": "eslint src/ tests/ --ext .ts"
  },
  "files": [
    "dist/",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "cordis": "^4.0.0-rc.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.5",
    "msw": "^2.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dsh": {
    "bundle": {
      "entry": "dist/index.js",
      "type": "plugin",
      "name": "dsh-ci"
    }
  }
}
