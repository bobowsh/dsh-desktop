node_modules/
out/
dist/
dist-dev/
.DS_Store
*.log
coverage/
build/icon.iconset/
build/app-icon.iconset/
build/icon-1024.png
# Generated bundled profile (regenerated by scripts/bundle-user-data.mjs at build).
# Keep the web profile's source-of-truth manifests tracked so CI can reproduce
# the plugin tree; the heavy/non-source bits stay ignored.
#   tracked:   data/profiles/web/{package.json,pnpm-lock.yaml,
#             pnpm-workspace.yaml,cordis.yml,cordis.patch.yml}
#             (data/settings.yaml is GENERATED from data/settings.template.yaml
#              by the bundle script, so it is git-ignored rather than tracked;
#              data/settings.template.yaml IS the tracked baseline template)
#   ignored:   the prebuilt mnemon CLI (data/bin); the web profile's node_modules
#              is TRACKED for offline use (see the ! re-include rules near the top)
# Runtime/secret user data created by the app at $INSTDIR\data must never be
# committed or shipped — the installer only seeds the artifacts above.
data/.credentials.yaml
data/settings.yaml
data/sessions/
data/storages/
data/cache/
data/change-ledger/
data/sticky-notes/
data/attachments/
data/memory/
data/bin/
# Runtime check-marker files produced by profile tools on first use
data/*.checked.json
data/dsh-chat-import/scan-cache.json
# Agent/IDE runtime data (WorkBuddy)
.workbuddy/
# Local npm cache
.npm-cache/
# Runtime notes / logs produced by the app
.dsh-notes/
# User runtime data under data/ (import scratch, enhancer process state)
data/dsh-chat-import/
data/dsh-prompt-enhancer*.json
# One-off debug scripts
test/check-persistence-list*.mjs
.env
.env.*
!.env.example

# ==== node_modules 恢复规则（必须保持在文件末尾：git 按「最后匹配的规则」生效）====
# 离线部署：data/profiles/web 的 node_modules 整体纳入 git 管理
# （该目录会随安装包分发，必须自带依赖才能离线运行；
#   用 ! 恢复而非 git add -f，否则后续 pnpm install 新增的包不会被跟踪）
!data/profiles/web/node_modules/
!data/profiles/web/node_modules/**/
# 包内 dist/ 常是 main 入口（@codemirror/@lezer/quickjs 等），离线必须保留
!data/profiles/web/node_modules/**/dist/
# node-pty 的 arm64 原生组件（本机 x64 部署用不到，排除以减小仓库体积）
data/profiles/web/node_modules/node-pty/third_party/conpty/*/win10-arm64/
