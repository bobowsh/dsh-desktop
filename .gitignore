# Generated bundled profile (regenerated by scripts/bundle-user-data.mjs at build).
# Keep the web profile's source-of-truth manifests tracked so CI can reproduce
# the plugin tree; the heavy/non-source bits stay ignored.
#   tracked:   data/profiles/web/{package.json,pnpm-lock.yaml,
#             pnpm-workspace.yaml,cordis.yml,cordis.patch.yml}
#             (data/settings.yaml is GENERATED from data/settings.template.yaml
#              by the bundle script, so it is git-ignored rather than tracked;
#              data/settings.template.yaml IS the tracked baseline template)
#   ignored:   the prebuilt mnemon CLI (data/bin); the web profile's node_modules
#              is NOT tracked (gitignored) — reproduced from the lockfile via `pnpm install`
# Local session-log repair backups (data/backups/*.jsonl.zstd are machine-local artifacts)
data/backups/
# Runtime/secret user data created by the app at $INSTDIR\data must never be
# committed or shipped — the installer only seeds the artifacts above.
data/.credentials.yaml
data/settings.yaml
data/sessions/
data/storages/
data/cache/
data/change-ledger/
data/sticky-notes/
data/attachments/
data/memory/
data/bin/
# Runtime check-marker files produced by profile tools on first use
data/*.checked.json
data/dsh-chat-import/scan-cache.json
# Agent/IDE runtime data (WorkBuddy)
.workbuddy/
# Local npm cache
.npm-cache/
# pnpm content-addressable store (machine-local cache, never tracked)
.pnpm-store/
# OpenWiki generated evidence index (regenerated by CI)
openwiki/
.github/workflows/openwiki-update.yml
# App runtime state / generated profile agents
data/dsh-prompt-manager/
data/profiles/web/.dsh-market/log.ndjson
data/profiles/web/.install-complete
data/profiles/web/.npmrc

# Runtime notes / logs produced by the app
.dsh-notes/
# User runtime data under data/ (import scratch, enhancer process state)
data/dsh-chat-import/
data/dsh-prompt-enhancer*.json
# One-off debug scripts
test/check-persistence-list*.mjs
.env
.env.*
!.env.example
.coaligne/
.coaligneignore

# ==== web profile 的 node_modules：不纳入 git（gitignored）====
# 早期曾用 ! 规则把 data/profiles/web/node_modules 整体纳入 git 以支持离线部署；
# 因体积过大（1.8 万+ 文件）已改为不跟踪。依赖改为从 lockfile 重建：
#   在 data/profiles/web/ 跑 `pnpm install --no-frozen-lockfile`（仓库内 pnpm v11.21.0，
#   NODE_OPTIONS="" + 绝对 Windows 路径调托管 node）即可按清单重建 node_modules。
# 顶层全局 `node_modules/` 规则已涵盖本目录，无需额外 ! 恢复。

# ==== app 运行时数据 / 本地产物（不纳入 git）====
# 运行时认证/凭据与 prompt 库 DB（用户使用 app 时生成，含敏感/易变数据）
data/auth/
data/prompt-library/
# 设计产物（某次 session 的 design 输出，非仓库源码）
design/
# 打包安装器绝不可覆盖的 API key（防御性忽略：extraFiles filter 已排除，这里双保险）
data/.credentials.yaml
